{
  "name": "remotion-motion-replica",
  "version": "1.0.0",
  "private": true,
  "description": "An editorial motion-graphics starter for Remotion: paper palette, fake UI windows, marker highlights, count-ups, hand-drawn SVG strokes.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render MotionFaceStudy out/study.mp4",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["remotion", "motion-graphics", "video", "template"],
  "license": "MIT",
  "dependencies": {
    "remotion": "4.0.466",
    "@remotion/cli": "4.0.466",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
